# Server
PORT=8080

# Database
DATABASE_URL=postgres://localhost:5433/anchored_oss?sslmode=disable

# CORS — comma-separated origins for browser clients (the dashboard).
# CORS_ALLOWED_ORIGINS=https://memory.yourteam.com

# Rate limiting (overrides config.yaml). RATE_LIMIT_ENABLED=0 to disable.
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_RPM=600

# Audit retention in days (0 = keep forever).
# AUDIT_RETENTION_DAYS=90

# Embeddings: provider key (only when embeddings.provider=openai). The variable
# name is whatever embeddings.api_key_env points at in config.yaml.
# OPENAI_API_KEY=sk-...
